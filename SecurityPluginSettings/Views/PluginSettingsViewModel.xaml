<Window x:Class="SecurityPluginSettings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SecurityPluginSettings"
        xmlns:helper="clr-namespace:SecurityPluginSettings.Helper"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

<Window.Resources>
    <helper:PostDisplayMultiConverter x:Key="PostDisplayMultiConverter" />
</Window.Resources>


    <ScrollViewer>
        <ItemsControl ItemsSource="{Binding Posts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="10"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Margin="5" Height="80" Width="80">
                        <TextBlock TextAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource PostDisplayMultiConverter}">
                                    <Binding Path="." />
                                    <Binding Path="DataContext.ShowIds" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>

</Window>
